{
  "name": "vue3-chessboard",
  "version": "1.3.4",
  "description": "vue3-chessboard is a component library for creating chess web apps with vue3",
  "homepage": "https://qwerty084.github.io/vue3-chessboard-docs/",
  "keywords": [
    "vue",
    "chessboard",
    "chess",
    "vue3",
    "lichess",
    "chessground",
    "chess.js",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "license": "GPL-3.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/vue3-chessboard.js"
    },
    "./style.css": "./dist/style.css"
  },
  "types": "./dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwerty084/vue3-chessboard.git"
  },
  "bugs": {
    "url": "https://github.com/qwerty084/vue3-chessboard/issues",
    "email": "github@lucahelms.dev"
  },
  "author": {
    "name": "Luca Hendrik Helms",
    "email": "github@lucahelms.dev"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --project tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest --environment jsdom --dir src/",
    "build-only": "vite build",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "chess.js": "~1.1.0",
    "chessground": "^9.2.1"
  },
  "peerDependencies": {
    "vue": "^3.2.47"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/server-renderer": "3.3.2",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "0.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "3.3.2",
    "vue-tsc": "^3.3.12"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
